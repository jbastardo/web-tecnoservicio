# ==============================================================================
# ONPROTEC - SALA DE CAPACITACIONES (CONFIGURACIÓN DE ENTORNO)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVIDOR Y APLICACIÓN
# Host Port expuesto para Cloudflare Tunnel: 6008 -> Container: 3000
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://capacitacion.tutecnoservicio.com
NEXT_PUBLIC_COMPANY_NAME="Onprotec C.A."
NEXT_PUBLIC_ROOM_MAX_CAPACITY=18
NEXT_PUBLIC_INSTRUCTOR_CAPACITY=1

# ------------------------------------------------------------------------------
# BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:onprotec_secure_pwd@db:5432/onprotec_capacitaciones?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=onprotec_secure_pwd
DB_NAME=onprotec_capacitaciones

# ------------------------------------------------------------------------------
# INTEGRACIÓN: PABILO (PASARELA Y VALIDACIÓN AUTOMÁTICA DE PAGOS)
# ------------------------------------------------------------------------------
PABILO_API_URL=https://api.pabilo.com/v1
PABILO_API_KEY=pab_live_xxxxxxxxxxxxxxxxxxxxxxxx
PABILO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
PABILO_MERCHANT_ID=merch_onprotec_01

# ------------------------------------------------------------------------------
# INTEGRACIÓN: ODOO ERP (CATÁLOGO DE PRODUCTOS / SKUs DE CURSOS)
# ------------------------------------------------------------------------------
ODOO_URL=https://erp.onprotec.com
ODOO_DB=onprotec_production
ODOO_USERNAME=api_capacitaciones@onprotec.com
ODOO_PASSWORD=odoo_api_token_or_password

# ------------------------------------------------------------------------------
# INTEGRACIÓN: WHATSAPP (RECORDATORIOS 24H, CONFIRMACIÓN Y ENCUESTAS)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_VERIFY_TOKEN=onprotec_wa_verify_2026
WHATSAPP_GATEWAY_URL=http://wa-gateway:8080/api/send

# ------------------------------------------------------------------------------
# SEGURIDAD Y PANEL ADMINISTRATIVO
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=clave_super_secreta_administrador_onprotec_2026
AUTH_COOKIE_NAME=onprotec_session
