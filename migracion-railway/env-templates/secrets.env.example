# ==============================================================================
# PLANTILLA MASTER DE SECRETS & CONEXIONES - PROXMOX / COOLIFY / RAILWAY
# ==============================================================================
# INSTRUCCIONES: Copia este archivo como `secrets.env` (este último está ignorado por git).
# Rellena los valores reales de conexión de tus bases de datos, APIs y Coolify.
# ==============================================================================

# 1. INFRAESTRUCTURA LOCAL & PROXMOX
PROXMOX_HOST_IP=192.168.1.32
COOLIFY_UI_URL=http://192.168.1.32:8000
COOLIFY_API_TOKEN=cp_token_aqui...

# 2. CLOUDFLARE TUNNEL (DOMINIOSTT)
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 3. CONEXIONES A BASES DE DATOS (MIGRACIÓN RAILWAY -> COOLIFY)
# PostgreSQL Local / Coolify
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=192.168.1.32
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Redis Cache / Queue
REDIS_HOST=192.168.1.32
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. API KEYS & TELEGRAM / WHATSAPP BOTS
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 5. CREDENCIALES FERROZO / DONWEB EMAIL
SMTP_HOST=l0051632.ferozo.com
SMTP_PORT=465
SMTP_USER=contacto@tutecnoservicio.com
SMTP_PASS=
